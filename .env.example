GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
FRONTEND_ORIGIN=http://localhost:3000

# Used by the React development server to reach the Express server.
REACT_APP_BACKEND_URL=http://localhost:5000

# Hosted Judge0-compatible provider configuration. Verify every value against
# the selected provider's current documentation; no provider is assumed.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=
JUDGE0_AUTH_SCHEME=
JUDGE0_SUBMISSIONS_PATH=/submissions/?base64_encoded=false&wait=false
JUDGE0_SUBMISSION_PATH=/submissions/{token}?base64_encoded=false
JUDGE0_BASE64_ENCODED=false
JUDGE0_LANGUAGE_ID_C=103
JUDGE0_LANGUAGE_ID_CPP=105
JUDGE0_LANGUAGE_ID_PYTHON=92
JUDGE0_LANGUAGE_ID_JAVA=91
JUDGE0_LANGUAGE_ID_JAVASCRIPT=97
JUDGE0_SOURCE_LIMIT_BYTES=262144
JUDGE0_STDIN_LIMIT_BYTES=65536
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_POLL_INTERVAL_MS=750
JUDGE0_POLL_TIMEOUT_MS=30000
EXECUTION_RATE_LIMIT=10
